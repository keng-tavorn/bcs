# --- แอป ---
APP_ENV=local                     # local | preview | staging | production
APP_URL=http://localhost:3000
SEED_DEV_PASSWORD=change-me-dev-only

# --- ฐานข้อมูล (Neon: DATABASE_URL = pooled, DIRECT_URL = direct) ---
DATABASE_URL=postgresql://bcs_app:bcs_app@localhost:5432/bcs
DIRECT_URL=postgresql://bcs_migrator:bcs_migrator@localhost:5432/bcs

# --- Auth และการเข้ารหัส ---
BETTER_AUTH_SECRET=change-me-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
ENCRYPTION_KEY=base64:REPLACE_WITH_32_RANDOM_BYTES_BASE64

# --- ที่เก็บไฟล์ (S3 API) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=bcs-local
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# --- อีเมล ---
EMAIL_PROVIDER=smtp               # smtp | resend | ses (ADR-031)
# 127.0.0.1 ไม่ใช่ localhost: บน Windows ตัวส่งอีเมล (nodemailer) หาชื่อ localhost ช้าได้ถึง 20 วินาทีต่อโปรเซส (S8-14)
EMAIL_SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="BCS <no-reply@bcs.local>"
# Invoice inbox (ADR-123): mailpit | disabled · unset = mailpit on local, disabled elsewhere
# INVOICE_INBOX_PROVIDER=mailpit
# MAILPIT_API_URL=http://localhost:8025

# ตรวจตัวตนผู้ขาย (FR-SUP-001 · OQ-37): stub = ข้อมูลจำลอง · live = เรียกบริการจริง
REGISTRY_MODE=stub
RD_VAT_SERVICE_URL=https://rdws.rd.go.th/serviceRD3/vatserviceRD3.asmx
DBD_JURISTIC_API_URL=https://openapi.dbd.go.th/api/v1/juristic_person

# --- Inngest ---
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- LINE (ค่าต่อองค์กรเก็บใน LineChannelConfig ค่านี้ใช้กับ local และ OA กลาง) ---
LINE_PROVIDER_ID=
LINE_MESSAGING_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LIFF_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=
# ที่อยู่ LINE data API (อัปโหลดภาพ rich menu) · ว่าง = https://api-data.line.me ซึ่งเป็นค่าเดียวที่รับนอก local
# บนเครื่องใช้ fake LINE server ได้: รัน pnpm line:fake (พอร์ต 4100 เปลี่ยนด้วย FAKE_LINE_PORT) แล้วตั้งค่านี้และ
# LINE_API_BASE_URL เป็น http://127.0.0.1:4100 · fake ตรวจ token กับ LINE_MESSAGING_CHANNEL_ACCESS_TOKEN และเซ็น webhook
# ทดสอบด้วย LINE_MESSAGING_CHANNEL_SECRET (secret ต้องเป็นเลขฐานสิบหก 32 ตัว เหมือนของจริง)
LINE_DATA_API_BASE_URL=

# --- BCS Go (S17 · ADR-163 ADR-166) ---
# package ของแอป Android และลายนิ้วมือ SHA-256 ของใบรับรองที่เซ็น APK (คั่นด้วย , ได้หลายใบ) · ตั้งครบสองค่า
# /.well-known/assetlinks.json จึงตอบ (passkey ในแอปต้องใช้) · ว่าง = 404 · หาค่าตาม docs/runbooks/bcs-go-demo.md
BCS_GO_ANDROID_PACKAGE=
BCS_GO_ANDROID_CERT_SHA256=
# push ในแอป (S17-10 · ADR-165): fcm = Firebase Cloud Messaging ต้องมี FCM_PROJECT_ID และ FCM_SERVICE_ACCOUNT_JSON_B64
# (ไฟล์ key ของ service account แปลงเป็น base64 ใส่เองในไฟล์นี้ ห้ามวางในแชท) · fake = fake FCM ของ pnpm line:fake (local เท่านั้น
# ตั้ง FCM_API_BASE_URL=http://127.0.0.1:4100/fcm และ FCM_TOKEN_URL=http://127.0.0.1:4100/fcm/token) · off หรือว่าง = ไม่ส่ง push
PUSH_PROVIDER=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_B64=
FCM_API_BASE_URL=
FCM_TOKEN_URL=

# --- SSO (S5) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=

# --- AI (ชั้น 4 เท่านั้น · S13 · ADR-142) ---
# false = ปิดทุก agent ทั้งระบบ ฟีเจอร์อื่นทำงานครบ (EG-1) · true ต้องตั้ง AI_MODE
AI_ENABLED=false
# fixture = ตอบจากคำตอบที่บันทึกใน tests/fixtures/ai (บนเครื่องและเทสต์เท่านั้น ไม่ต้องมี key)
# live = เรียก Claude จริง ต้องมี ANTHROPIC_API_KEY และใช้ได้เฉพาะชุดที่ผ่านชุดประเมิน (staging production ใช้ live เท่านั้น)
AI_MODE=fixture
# key ของ BCS จาก Claude Console (P0-13 · OQ-143) ใส่เองในไฟล์ .env ห้ามวางในแชท
ANTHROPIC_API_KEY=
# รุ่นโมเดล: ว่าง = ค่าตาม OQ-145 ใน src/lib/ai-config.ts · ตั้งต่อ agent ได้ · เปลี่ยนรุ่นต้องผ่านชุดประเมินใหม่ (BR-AI-09)
AI_MODEL_DEFAULT=
AI_MODEL_DOCUMENT=
AI_MODEL_INTAKE=
AI_MODEL_BRIEF=
AI_MODEL_INSIGHT=
AI_MODEL_DOA_DRAFTER=

# --- ส่วนที่เพิ่มจากภาคผนวก B (ดู docs/sub-specs/S1.md และ docs/decisions/) ---
# seed: secret ของ TOTP ผู้ใช้ตัวอย่าง (เฉพาะ local/staging) · ใช้ค่าสุ่มยาวอย่างน้อย 32 ตัวอักษร แยกจาก SEED_DEV_PASSWORD
SEED_TOTP_KEY=change-me-dev-only-totp-key-32chars
# seed: PIN ยืนยันธุรกรรม 6 หลักของผู้ใช้ตัวอย่างที่ดำรงตำแหน่งใน DOA (เฉพาะ local/staging · S5-05) ใช้ยืนยันยอดสูงใน LIFF และบนเว็บ
# ว่าง = ไม่มีใครมี PIN ผู้อนุมัติตั้งเองตอนใช้ครั้งแรก · ห้ามเลขเดาง่าย (เลขเดียวกันทั้งชุด เลขเรียง เลขยอดนิยม) seed จะปฏิเสธ
SEED_DEV_PIN=
# ใส่อัตโนมัติตอน deploy (commit ที่ deploy) ไม่ต้องตั้งเอง
APP_COMMIT_SHA=
# ที่อยู่ LINE API · บนเครื่องและ e2e ชี้ไปที่ fake LINE server
LINE_API_BASE_URL=https://api.line.me
# เฉพาะ local: นาฬิกาทดสอบและ LIFF จำลองสำหรับ e2e (env.ts ปฏิเสธบน staging/production)
E2E_TEST_CLOCK=
LIFF_MOCK=
# เฉพาะเครื่องผู้พัฒนา: token สำหรับ deploy ด้วย Vercel CLI (ห้ามใส่ใน Environment Variables ของ Vercel)
VERCEL_TOKEN=
# เฉพาะ Windows ที่ AppData มีสิทธิ์ของ sandbox (เช่น SID S-1-15-3-…) แล้ว next ล้มด้วย ERR_SWC_NATIVE_CACHE (NEW-89):
# ชี้ cache ของ @swc/core ไปโฟลเดอร์ใต้โฟลเดอร์ผู้ใช้ที่มีสิทธิ์เฉพาะผู้ใช้ SYSTEM และ Administrators เช่น C:\Users\<ชื่อผู้ใช้>\.swc-native-cache
# ว่าง = ใช้ cache ปกติ · Linux/macOS และ CI ไม่ต้องตั้ง
SWC_NATIVE_BINDING_CACHE=
