# --- แอป ---
APP_ENV=local                     # local | preview | staging | production
APP_URL=http://localhost:3000
SEED_DEV_PASSWORD=change-me-dev-only

# --- ฐานข้อมูล (Neon: DATABASE_URL = pooled, DIRECT_URL = direct) ---
DATABASE_URL=postgresql://bcs_app:bcs_app@localhost:5432/bcs
DIRECT_URL=postgresql://bcs_migrator:bcs_migrator@localhost:5432/bcs

# --- Auth และการเข้ารหัส ---
BETTER_AUTH_SECRET=change-me-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
ENCRYPTION_KEY=base64:REPLACE_WITH_32_RANDOM_BYTES_BASE64

# --- ที่เก็บไฟล์ (S3 API) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=bcs-local
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# --- อีเมล ---
EMAIL_PROVIDER=smtp               # smtp | resend | ses (ADR-031)
EMAIL_SMTP_URL=smtp://localhost:1025
EMAIL_FROM="BCS <no-reply@bcs.local>"

# ตรวจตัวตนผู้ขาย (FR-SUP-001 · OQ-37): stub = ข้อมูลจำลอง · live = เรียกบริการจริง
REGISTRY_MODE=stub
RD_VAT_SERVICE_URL=https://rdws.rd.go.th/serviceRD3/vatserviceRD3.asmx
DBD_JURISTIC_API_URL=https://openapi.dbd.go.th/api/v1/juristic_person

# --- Inngest ---
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- LINE (ค่าต่อองค์กรเก็บใน LineChannelConfig ค่านี้ใช้กับ local และ OA กลาง) ---
LINE_PROVIDER_ID=
LINE_MESSAGING_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LIFF_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=
# ที่อยู่ LINE data API (อัปโหลดภาพ rich menu) · ว่าง = https://api-data.line.me ซึ่งเป็นค่าเดียวที่รับนอก local
# บนเครื่องใช้ fake LINE server ได้: รัน pnpm line:fake (พอร์ต 4100 เปลี่ยนด้วย FAKE_LINE_PORT) แล้วตั้งค่านี้และ
# LINE_API_BASE_URL เป็น http://127.0.0.1:4100 · fake ตรวจ token กับ LINE_MESSAGING_CHANNEL_ACCESS_TOKEN และเซ็น webhook
# ทดสอบด้วย LINE_MESSAGING_CHANNEL_SECRET (secret ต้องเป็นเลขฐานสิบหก 32 ตัว เหมือนของจริง)
LINE_DATA_API_BASE_URL=

# --- SSO (S5) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=

# --- AI (ชั้น 4 เท่านั้น) ---
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-sonnet-5-5   # ตัวอย่าง รุ่นจริงเลือกจากผลชุดประเมิน (§12.4)

# --- ส่วนที่เพิ่มจากภาคผนวก B (ดู docs/sub-specs/S1.md และ docs/decisions/) ---
# seed: secret ของ TOTP ผู้ใช้ตัวอย่าง (เฉพาะ local/staging) · ใช้ค่าสุ่มยาวอย่างน้อย 32 ตัวอักษร แยกจาก SEED_DEV_PASSWORD
SEED_TOTP_KEY=change-me-dev-only-totp-key-32chars
# seed: PIN ยืนยันธุรกรรม 6 หลักของผู้ใช้ตัวอย่างที่ดำรงตำแหน่งใน DOA (เฉพาะ local/staging · S5-05) ใช้ยืนยันยอดสูงใน LIFF และบนเว็บ
# ว่าง = ไม่มีใครมี PIN ผู้อนุมัติตั้งเองตอนใช้ครั้งแรก · ห้ามเลขเดาง่าย (เลขเดียวกันทั้งชุด เลขเรียง เลขยอดนิยม) seed จะปฏิเสธ
SEED_DEV_PIN=
# ใส่อัตโนมัติตอน deploy (commit ที่ deploy) ไม่ต้องตั้งเอง
APP_COMMIT_SHA=
# ที่อยู่ LINE API · บนเครื่องและ e2e ชี้ไปที่ fake LINE server
LINE_API_BASE_URL=https://api.line.me
# เฉพาะ local: นาฬิกาทดสอบและ LIFF จำลองสำหรับ e2e (env.ts ปฏิเสธบน staging/production)
E2E_TEST_CLOCK=
LIFF_MOCK=
# เฉพาะเครื่องผู้พัฒนา: token สำหรับ deploy ด้วย Vercel CLI (ห้ามใส่ใน Environment Variables ของ Vercel)
VERCEL_TOKEN=
