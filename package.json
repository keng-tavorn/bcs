{
  "name": "bcs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.7 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "messages:build": "node scripts/build-messages.mjs",
    "predev": "node scripts/build-messages.mjs",
    "prebuild": "node scripts/build-messages.mjs",
    "lint": "eslint .",
    "typecheck": "node scripts/build-messages.mjs && next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:golden": "vitest run --project golden",
    "test:property": "vitest run --project property",
    "test:int": "vitest run --project int",
    "test:e2e": "playwright test",
    "verify": "tsx scripts/verify.ts",
    "spec:check": "node scripts/py.mjs scripts/spec_check.py spec.md",
    "inputs:check": "node scripts/py.mjs scripts/validate_inputs.py docs/inputs/BCS_inputs_v1_demo.xlsx --spec spec.md",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db-reset.ts",
    "line:fake": "tsx --env-file-if-exists=.env scripts/fake-line.ts",
    "line:simulate": "tsx --env-file-if-exists=.env scripts/line-simulate.ts",
    "line:richmenu": "tsx --env-file-if-exists=.env scripts/line-richmenu.ts",
    "demo:reset": "tsx scripts/demo-reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@line/bot-sdk": "^11.3.0",
    "@line/liff": "^2.31.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-pdf/renderer": "4.9.0",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "inngest": "^4.21.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-intl": "^4.14.8",
    "nodemailer": "^10.0.13",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "tailwind-merge": "^3.7.0",
    "uqr": "0.1.3",
    "uuid": "^14.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@prisma/internals": "7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "fast-check": "^4.10.2",
    "pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.28",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
