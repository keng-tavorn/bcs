// BCS data model (spec §6). Conventions §6.1: uuid v7 ids generated by Prisma Client, organizationId on every
// tenant table, timestamptz(6) in UTC, money as BigInt satang (…Satang), rates as basis points (…Bp).
// Append-only tables (Event, later BudgetLedgerEntry/EventSeal) carry createdAt only.

generator client {
  provider        = "prisma-client"
  output          = "../src/server/db/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------- Platform & tenancy (S1) ----------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id                          String             @id @default(uuid(7)) @db.Uuid
  code                        String             @unique
  legalNameTh                 String
  legalNameEn                 String?
  displayName                 String?
  taxId                       String
  branchCode                  String             @default("00000")
  address                     String?
  timezone                    String             @default("Asia/Bangkok")
  locale                      String             @default("th")
  /// Must pass OrgSettingsSchema (Zod) on every save (FR-PLT-001 AC2)
  settings                    Json               @default("{}")
  status                      OrganizationStatus @default(ACTIVE)
  dataRegion                  String             @default("ap-southeast-1")
  /// Set by PLATFORM_ADMIN after checking the contract; approves only the bootstrap set (BR-DOA-19)
  contractSignatoryMemberId   String?            @db.Uuid
  contractSignatoryVerifiedAt DateTime?          @db.Timestamptz(6)
  createdAt                   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime           @updatedAt @db.Timestamptz(6)

  contractSignatory  Member?             @relation("OrganizationContractSignatory", fields: [contractSignatoryMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  members            Member[]            @relation("OrganizationMembers")
  modules            OrgModule[]
  roleAssignments    RoleAssignment[]
  events             Event[]
  outbox             Outbox[]
  commandLogs        CommandLog[]
  files              FileObject[]
  fileLinks          FileLink[]
  notifications      Notification[]
  breakGlassSessions BreakGlassSession[]
}

enum ModuleKey {
  CORE
  PAY
  SUPPLIER
  SOURCING
  RISK
  CONTRACTS
  AI
  INTEGRATION
  DOA_EVERYWHERE
  BCS_GO
}

model OrgModule {
  id                       String    @id @default(uuid(7)) @db.Uuid
  organizationId           String    @db.Uuid
  module                   ModuleKey
  enabled                  Boolean   @default(false)
  enabledAt                DateTime? @db.Timestamptz(6)
  disabledAt               DateTime? @db.Timestamptz(6)
  changedByPlatformAdminId String?   @db.Uuid
  contractRef              String?
  reason                   String?
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(6)

  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changedByPlatformAdmin PlatformAdmin? @relation(fields: [changedByPlatformAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, module])
  @@index([organizationId])
}

enum MemberStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

model Member {
  id                  String       @id @default(uuid(7)) @db.Uuid
  organizationId      String       @db.Uuid
  /// Better Auth user id (identity only); null while INVITED. FK added with the auth tables (S1-07).
  userId              String?      @db.Uuid
  displayNameTh       String
  displayNameEn       String?
  email               String
  phone               String?
  employeeCode        String?
  /// FK to Department added in S2-01
  primaryDepartmentId String?      @db.Uuid
  status              MemberStatus @default(INVITED)
  transactionPinHash  String?
  pinFailedCount      Int          @default(0)
  pinLockedUntil      DateTime?    @db.Timestamptz(6)
  lineReachable       Boolean      @default(true)
  notificationPrefs   Json         @default("{}")
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)

  organization         Organization     @relation("OrganizationMembers", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  signatoryFor         Organization[]   @relation("OrganizationContractSignatory")
  roleAssignments      RoleAssignment[] @relation("MemberRoles")
  rolesGranted         RoleAssignment[] @relation("RoleGrantedBy")
  notifications        Notification[]
  uploadedFiles        FileObject[]

  @@unique([organizationId, userId])
  @@unique([organizationId, email])
  @@unique([organizationId, employeeCode])
  @@index([organizationId])
}

/// Roles of spec §2.2 that are stored. REQUESTER is implicit for every active member and never stored;
/// PLATFORM_ADMIN is not a member role. "Approver" is never a role (authority comes from DOA only).
enum RoleCode {
  PROCUREMENT
  FINANCE
  BUDGET_ADMIN
  RECEIVER
  EXECUTIVE
  AUDITOR
  ORG_ADMIN
  REVIEWER_IT
  REVIEWER_LEGAL
  REVIEWER_FINANCE
  REVIEWER_INFOSEC
}

model RoleAssignment {
  id                       String    @id @default(uuid(7)) @db.Uuid
  organizationId           String    @db.Uuid
  memberId                 String    @db.Uuid
  role                     RoleCode
  /// FK to Department added in S2-01
  scopeDepartmentId        String?   @db.Uuid
  /// Exactly one of grantedById / grantedByPlatformAdminId is set (bootstrap ORG_ADMIN is granted by PLATFORM_ADMIN)
  grantedById              String?   @db.Uuid
  grantedByPlatformAdminId String?   @db.Uuid
  grantedAt                DateTime  @db.Timestamptz(6)
  revokedAt                DateTime? @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(6)

  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  member                 Member         @relation("MemberRoles", fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedBy              Member?        @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedByPlatformAdmin PlatformAdmin? @relation(fields: [grantedByPlatformAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, memberId, role], map: "role_assignment_active_unique", where: raw("\"revokedAt\" IS NULL"))
  @@index([organizationId, memberId])
}

/// BCS team account (global, not a Member of any organization — spec §6.1)
model PlatformAdmin {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Better Auth user id; FK added with the auth tables (S1-07)
  userId      String?  @unique @db.Uuid
  displayName String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  moduleChanges      OrgModule[]
  rolesGranted       RoleAssignment[]
  breakGlassSessions BreakGlassSession[]
}

/// Global table (spec §4.8) even though it records the tenant it opens (BR-AUTH-03)
model BreakGlassSession {
  id              String    @id @default(uuid(7)) @db.Uuid
  platformAdminId String    @db.Uuid
  organizationId  String    @db.Uuid
  reason          String
  startsAt        DateTime  @db.Timestamptz(6)
  endsAt          DateTime  @db.Timestamptz(6)
  endedAt         DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId])
}

// ---------- Audit trail & command pipeline (S1, spec §4.3–§4.5) ----------

enum ActorType {
  USER
  SYSTEM
  AI_AGENT
  SUPPLIER
  PLATFORM_ADMIN
}

enum Channel {
  WEB
  LIFF
  LINE_CHAT
  PWA
  EMAIL
  PORTAL
  SYSTEM
  API
  MCP
}

/// Append-only audit trail and KPI source (INV-EVT-01, trigger in migration). Never UPDATE or DELETE.
model Event {
  id                   String    @id @default(uuid(7)) @db.Uuid
  seq                  BigInt    @unique @default(autoincrement())
  /// null only for platform-level events
  organizationId       String?   @db.Uuid
  type                 String
  aggregateType        String
  aggregateId          String    @db.Uuid
  occurredAt           DateTime  @db.Timestamptz(6)
  actorType            ActorType
  actorMemberId        String?   @db.Uuid
  actorPlatformAdminId String?   @db.Uuid
  onBehalfOfMemberId   String?   @db.Uuid
  agentId              String?
  channel              Channel
  /// Required on approval decision events (INV-DOA-01)
  doaVersionId         String?   @db.Uuid
  doaRuleCode          String?
  correlationId        String    @db.Uuid
  causationId          String?   @db.Uuid
  requestId            String
  data                 Json
  schemaVersion        Int
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, aggregateType, aggregateId, seq])
  @@index([organizationId, type, occurredAt])
  @@index([correlationId])
}

/// Transactional outbox relayed to Inngest (ADR-030); Outbox.id is the Inngest event id.
model Outbox {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  eventName      String
  payload        Json
  sentAt         DateTime? @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastError      String?
  /// History created by the demo seed is never dispatched (no reminders or LINE pushes for the past)
  suppressed     Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId])
  @@index([sentAt, createdAt])
}

/// Idempotency record of every command (INV-PLT-01). Insert-only for the app role; purged by the migrator.
model CommandLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  idempotencyKey String
  commandName    String
  inputHash      String
  result         Json
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, idempotencyKey])
}

// ---------- Files (S1) ----------

enum FileStatus {
  PENDING
  AVAILABLE
  REJECTED
}

enum FileScanStatus {
  NOT_REQUIRED
  NOT_SCANNED
  PENDING
  CLEAN
  INFECTED
}

model FileObject {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  storageKey     String         @unique
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String?
  status         FileStatus     @default(PENDING)
  uploadedById   String?        @db.Uuid
  scanStatus     FileScanStatus @default(NOT_SCANNED)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy   Member?      @relation(fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  links        FileLink[]

  @@index([organizationId])
}

enum FileLinkKind {
  QUOTATION
  DELIVERY_NOTE
  PHOTO
  JUSTIFICATION
  INVOICE
  PO_PDF
  DPA
  ETAX
  REGISTRY_PROOF
  OTHER
}

model FileLink {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  fileId         String       @db.Uuid
  subjectType    String
  subjectId      String       @db.Uuid
  kind           FileLinkKind
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  file         FileObject   @relation(fields: [fileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, subjectType, subjectId])
}

// ---------- Notifications (moved forward from S2: module changes notify ORG_ADMIN in S1) ----------

enum NotificationUrgency {
  IMMEDIATE
  DIGEST
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum NotificationChannel {
  IN_APP
  LINE
  EMAIL
}

model Notification {
  id                String               @id @default(uuid(7)) @db.Uuid
  organizationId    String               @db.Uuid
  recipientMemberId String               @db.Uuid
  templateKey       String
  data              Json
  urgency           NotificationUrgency
  status            NotificationStatus   @default(PENDING)
  dedupeKey         String
  sentChannel       NotificationChannel?
  sentAt            DateTime?            @db.Timestamptz(6)
  readAt            DateTime?            @db.Timestamptz(6)
  error             String?
  subjectType       String?
  subjectId         String?              @db.Uuid
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipient    Member       @relation(fields: [recipientMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, recipientMemberId, status])
}
